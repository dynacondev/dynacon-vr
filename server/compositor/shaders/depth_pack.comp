/*
 * Virtual-depth pack (depth video stream, one dispatch per warped frame).
 *
 * Reads the warp's target-view splat depth (R32Uint, DEPTH_SCALE-encoded
 * NDC, 0xffffffff sentinel = no splat) for both eyes at full render size
 * and packs a foveated side-by-side 10-bit image: left eye in
 * x[0..half), right eye in x[half..2*half), each eye at per-eye stream
 * resolution with the SAME foveation tables as color (shared gaze center
 * and source size — the tables live in color's per-slot UBO, read-only
 * here, never re-uploaded).
 *
 * Gather is a variable-footprint MIN over the shared table spans
 * (foreground wins, order-independent): bilinear filtering of nonlinear
 * NDC would blend foreground/background into false mid-depths and halo
 * every silhouette. The sentinel is the max uint, so a plain min ignores
 * holes automatically; all-sentinel windows stay sentinel.
 * No manual row flip: the shared y-tables already encode the
 * GL-ordered splat to top-down-wire mapping (same flip color
 * foveation bakes in). Re-introducing one would mirror vertically
 * with no validation complaint.
 *
 * Linearisation runs only at depth resolution: zt back to eye meters
 * via the dst frustum near/far (same math as depth_viz's
 * linearize_depth, mirrored here), then 2mm/LSB quantize: valid codes
 * 0-1020 (0-2.040m); holes, sky pinned at 1.0 and beyond-range all pin
 * to 1023 (far). Codes 1021-1023 are a guard band absorbing lossy
 * wobble; the client decodes anything past 1020 as far. The client
 * compares in meters: reveal = !(virt strictly nearer than the
 * rasterized window), far-vs-far is a VR win.
 */

#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Must match foveation.comp's table layout (same shared buffer).
#define MAX_DIM 4097

layout(set = 0, binding = 0, r32ui) readonly uniform uimage2D splat_l;
layout(set = 0, binding = 1, r32ui) readonly uniform uimage2D splat_r;
// Y plane of the depth staging image, 2D view on layer 3 (SBS canvas,
// 10-bit in R16). Geometry derives from the actual image (never
// hardcoded).
layout(set = 0, binding = 2, r16) writeonly uniform image2D dst_y;
// CbCr plane of the same staging image, 2D R16G16 view on layer 3
// (half-res 4:2:0). The pack writes the neutral chroma itself: a
// vkCmdClearColorImage here would be illegal (VUID-02498 aspect,
// VUID-01545 YCbCr-conversion format), and the driver silently drops
// it — which reads as +335 codes of green lift client-side.
layout(set = 0, binding = 3, rg16) writeonly uniform image2D dst_cbcr;
// Shared color foveation tables (per-slot storage buffer, read-only
// here): x[2*MAX_DIM], y[2*MAX_DIM], per-eye stride MAX_DIM.
layout(set = 0, binding = 4) readonly buffer Tables
{
	uint fx[2 * MAX_DIM];
	uint fy[2 * MAX_DIM];
}
tables;

layout(push_constant) uniform Push
{
	float near_l;
	float far_l;
	float near_r;
	float far_r;
}
pc;

#define DEPTH_SCALE 16777215.0
#define DEPTH_SENTINEL 0xffffffffu
#define LSB_PER_M 500.0
#define DEPTH_MAX_CODE 1023u
// Valid codes 0-1020 (0-2.040m); holes/sky/beyond-range pin to FAR_CODE.
// 1021-1023 is a guard band absorbing lossy wobble, decoded as far
// client-side.
#define VALID_MAX_CODE 1020u
#define FAR_CODE 1023u
#define VALID_MAX_M 2.040

float linearize(float d, float n, float f)
{
	if (!(f > n) || f > 1e9)
	{
		// Infinite far plane: D=0 -> near, D=1 -> far.
		return n / max(1.0 - d, 1e-6);
	}
	return (n * f) / max(f - d * (f - n), 1e-6);
}

void main()
{
	ivec2 out_xy = ivec2(gl_GlobalInvocationID.xy);
	ivec2 out_size = imageSize(dst_y);
	if (out_xy.x >= out_size.x || out_xy.y >= out_size.y)
		return;

	// Left eye x[0..half), right eye x[half..2*half): the eye index
	// selects the table slice, the in-eye coordinate the span.
	int half_w = out_size.x / 2;
	int iz = out_xy.x >= half_w ? 1 : 0;
	int ix = out_xy.x - iz * half_w;
	int iy = out_xy.y;

	// Shared-table spans (same decode as foveation.comp): the tables
	// already map GL-ordered splat rows to top-down output rows.
	uint xmin = tables.fx[MAX_DIM * iz + ix];
	uint xmax = tables.fx[MAX_DIM * iz + ix + 1];
	uint ymin = tables.fy[MAX_DIM * iz + iy];
	uint ymax = tables.fy[MAX_DIM * iz + iy + 1];
	if (xmin > xmax)
	{
		uint tmp = xmin;
		xmin = xmax;
		xmax = tmp;
	}
	if (ymin > ymax)
	{
		uint tmp = ymin;
		ymin = ymax;
		ymax = tmp;
	}

	uint best = DEPTH_SENTINEL;
	for (uint y = ymin; y < ymax; ++y)
	{
		for (uint x = xmin; x < xmax; ++x)
		{
			uint v = iz == 1 ? imageLoad(splat_r, ivec2(x, y)).x
			                 : imageLoad(splat_l, ivec2(x, y)).x;
			best = min(best, v);
		}
	}

	float u10;
	if (best == DEPTH_SENTINEL)
	{
		u10 = FAR_CODE; // hole: far
	}
	else
	{
		float zt = float(best) / DEPTH_SCALE;
		if (zt >= 1.0)
			u10 = FAR_CODE; // sky pinned at far: far
		else
		{
			float virt_m = linearize(zt, iz == 1 ? pc.near_r : pc.near_l, iz == 1 ? pc.far_r : pc.far_l);
			if (virt_m > VALID_MAX_M)
				u10 = FAR_CODE; // beyond-range: far
			else
				u10 = uint(clamp(virt_m * LSB_PER_M + 0.5, 0.0, float(VALID_MAX_CODE)));
		}
	}

	imageStore(dst_y, out_xy, vec4(float(u10) / float(DEPTH_MAX_CODE)));

	// Neutral chroma for the luma-only depth payload: Plane 1 is
	// half-res, so each even/even Y thread owns exactly one chroma
	// texel (staging dims are always even — encoder sizes).
	// UNORM16(0.5) = 0x8000, i.e. 10-bit neutral 512 in the upper
	// bits under the 3PACK16 low-6-pad convention.
	if ((out_xy.x & 1) == 0 && (out_xy.y & 1) == 0)
		imageStore(dst_cbcr, out_xy / 2, vec4(0.5, 0.5, 0.0, 1.0));
}
